# ── LLM ────────────────────────────────
# mock：无需 Key，内置规则引擎跑通全流程
# glm ：智谱开放平台（https://open.bigmodel.cn），glm-4-flash 免费
LLM_PROVIDER=mock
ZHIPU_API_KEY=
LLM_MODEL=glm-4-flash

# ── Embedding ──────────────────────────
# local：特征哈希向量，零依赖；openai：GLM embedding-3（需 Key，语义匹配质变，推荐）
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=embedding-3

# ── 检索阈值（两族嵌入分数尺度不可比，代码按 provider 自适应，一般无需配置）──
# RETRIEVAL_MIN_SCORE=0.05            # local-hash 用
# RETRIEVAL_MIN_SCORE_SEMANTIC=0.33   # embedding-3 用（实测无关≤0.295 / 相关≥0.374）

# ── 数据库（生产切 PostgreSQL）─────────
# DB_URL=postgresql+psycopg://user:pass@localhost:5432/commit_kb
